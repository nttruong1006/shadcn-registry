---
import { z } from 'astro/zod'
import ComponentList from './component-list'
import type { Component } from './lib'

// Schema
const componentFileSchema = z.object({
  frontmatter: z.object({
    title: z.string().min(1)
  }),
  url: z.string().optional()
})

// Extract components
const atomComponents: Component[] = []
const moleculeComponents: Component[] = []
const organismComponents: Component[] = []

const files = import.meta.glob('../../../content/docs/components/**/*.mdx', {
  eager: true
})

const filePaths = Object.keys(files)

for (const filePath of filePaths) {
  const { success, data } = componentFileSchema.safeParse(files[filePath])
  if (!success) {
    break
  }

  const name = filePath.split('/').pop()?.split('.').shift()
  if (!name) {
    break
  }

  const component: Component = {
    name,
    title: data.frontmatter.title
  }

  if (filePath.includes('atoms')) {
    atomComponents.push(component)
  } else if (filePath.includes('molecules')) {
    moleculeComponents.push(component)
  } else {
    organismComponents.push(component)
  }
}
---

<!-- Template -->
<div class="space-y-20 not-content">
  <ComponentList components={atomComponents} title="Atoms (Shadcn components)" type="atoms" />
  <ComponentList
    components={moleculeComponents}
    title="Molecules (Components that has built on top of Shadcn components)"
    type="molecules"
  />
  <ComponentList
    components={organismComponents}
    title="Organisms (Components that has built on top of Shadcn components and Molecule components)"
    type="organisms"
  />
</div>
