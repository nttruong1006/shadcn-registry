{
  "name": "shadcn-registry",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "registry:build": "shadcn build",
    "prepare": "husky || true",
    "lint-staged": "lint-staged",
    "check": "biome check --write --unsafe",
    "test": "ultracite fix"
  },
  "lint-staged": {
    "src/**/*.{astro,mdx,ts,tsx}": [
      "biome check --staged --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        0,
        "always",
        200
      ]
    }
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/react": "5.0.2",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/starlight": "^0.38.2",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@base-ui/react": "^1.3.0",
    "@embedpdf/react-pdf-viewer": "^2.8.0",
    "@expressive-code/plugin-line-numbers": "^0.41.3",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-form": "^1.27.7",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-color": "^3.10.7",
    "@tiptap/extension-file-handler": "^3.10.7",
    "@tiptap/extension-heading": "^3.10.7",
    "@tiptap/extension-highlight": "^3.10.7",
    "@tiptap/extension-image": "^3.10.7",
    "@tiptap/extension-list": "^3.10.7",
    "@tiptap/extension-table": "^3.10.7",
    "@tiptap/extension-text-align": "^3.10.7",
    "@tiptap/extension-text-style": "^3.22.3",
    "@tiptap/extension-youtube": "^3.10.7",
    "@tiptap/extensions": "^3.10.7",
    "@tiptap/pm": "^3.10.7",
    "@tiptap/react": "^3.10.7",
    "@tiptap/starter-kit": "^3.10.7",
    "@uidotdev/usehooks": "^2.4.1",
    "astro": "^6.1.1",
    "astro-robots-txt": "^1.0.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "color": "^5.0.2",
    "date-fns": "^4.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.24",
    "html-react-parser": "^5.2.8",
    "input-otp": "^1.4.2",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^0.554.00",
    "motion": "^12.23.25",
    "react": "^19.2.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.66.0",
    "react-number-format": "^5.4.4",
