{
  "name": "shadcn-registry",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "registry:build": "shadcn build",
    "prepare": "husky || true",
    "lint-staged": "lint-staged",
    "biome-migrate": "biome migrate --write",
    "check": "biome check --write --unsafe",
    "test": "ultracite fix"
  },
  "lint-staged": {
    "src/**/*.{astro,mdx,ts,tsx}": [
      "biome check --staged --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        0,
        "always",
        200
      ]
    }
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.3",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@base-ui/react": "^1.6.0",
    "@embedpdf/react-pdf-viewer": "^2.14.4",
    "@expressive-code/plugin-line-numbers": "^0.44.0",
    "@fontsource/geist": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@hookform/resolvers": "^5.4.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-color": "^3.27.2",
    "@tiptap/extension-file-handler": "^3.27.2",
    "@tiptap/extension-heading": "^3.27.2",
    "@tiptap/extension-highlight": "^3.27.2",
    "@tiptap/extension-image": "^3.27.2",
    "@tiptap/extension-list": "^3.27.2",
    "@tiptap/extension-table": "^3.27.2",
    "@tiptap/extension-text-align": "^3.27.2",
    "@tiptap/extension-text-style": "^3.27.2",
    "@tiptap/extension-youtube": "^3.27.2",
    "@tiptap/extensions": "^3.27.2",
    "@tiptap/pm": "^3.27.2",
    "@tiptap/react": "^3.27.2",
    "@tiptap/starter-kit": "^3.27.2",
    "@uidotdev/usehooks": "^2.4.1",
    "astro": "^7.0.6",
    "astro-robots-txt": "^1.0.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "color": "^5.0.3",
    "date-fns": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.42.2",
    "html-react-parser": "^6.1.4",
    "input-otp": "^1.4.2",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-dropzone": "^15.0.0",
    "react-number-format": "^5.4.5",
    "react-phone-number-input": "^3.4.17",
    "react-resizable-panels": "^4.12.1",
    "sonner": "^2.0.7",
    "starlight-theme-black": "^0.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "baseline-browser-mapping": "^2.10.42",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "rollup-plugin-visualizer": "^7.0.1",
    "shadcn": "^4.13.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ultracite": "7.9.2",
    "vite": "^8.1.3"
  }
}
